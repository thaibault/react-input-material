{
    "compilerOptions": {
        "rootDir": "src/",
        "declaration": true,
        "declarationDir": "dist/",
        "paths": {
            "#implementations/*": ["./src/implementations/rmwc/*"],
            "react-input-material/components/TextInput/CodeMirror": [
                "./src/components/TextInput/CodeMirror/index"
            ],
            "react-input-material/components/TextInput/Tiptap": [
                "./src/components/TextInput/Tiptap/index"
            ]
        }
    },
    "extends": "./node_modules/weboptimizer/tsconfig.json",
    "include": [
        "src/*.d.ts",
        "src/**/*.d.ts",
        "src/*.ts", "src/*.tsx",
        "src/**/*.ts", "src/**/*.tsx"
    ]
}
